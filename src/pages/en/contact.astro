---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL, LAST_UPDATED, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { displayDate } from '../../lib/format';
const lang = 'en';
---
<PageLayout title={`Contact ${SITE_NAMES[lang]}: a fee, a question, an embed`} description="Write to Behavior Tech Exam when a fee, a deadline or a state rule looks out of date, when a practice question seems wrong, or to embed the free quiz on a clinic or school site." lang={lang} noindex={true} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Contact</h1>
    <p>Email: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Every message is read by a person.</p>
    <h2>A fee, a deadline or a state rule has changed</h2>
    <p>Tell us which one and, if you can, the handbook page or the state board page that shows the new figure. We read the source again, update the parameter file and date the change.</p>
    <h2>A practice question looks wrong</h2>
    <p>Send its first words. Each question names the outline task it trains; if its answer is wrong or ambiguous we rewrite it or take it out.</p>
    <h2>What we cannot do</h2>
    <p>We are not the certification board, Pearson VUE or a state board. We cannot change an appointment, see an application or say whether you are eligible. Please never send a BACB ID, a background check, a competency form or anything about a client.</p>
    <h2>Using the quiz on your site</h2>
    <p>Clinics, colleges and workforce programs can show the quiz in an iframe for free: see the <a href={route('widget', lang)}>embed page</a>.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
    <p>Updated on <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, 'en-US')}</time>.</p>
  </div>
</PageLayout>
